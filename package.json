{
  "name": "hubperso",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard central du hub perso — consomme les GET /hub/summary des apps (contrat @mokarade/hub-contract) et rend des widgets génériques.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fumee": "node scripts/fumee.mjs",
    "portes": "node qualite/portes.mjs",
    "portes:maj": "node qualite/portes.mjs --maj",
    "db:generate": "drizzle-kit generate",
    "constellation": "tsx scripts/verifier-constellation.ts"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@mokarade/hub-contract": "github:MoKarade/hub-contract#v1.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "sharp": "^0.35.3",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
